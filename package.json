    "test:e2e": "jest --config ./test/jest-e2e.config.js",
    "build": "nest build"
  },
  "dependencies": {
    "@nestjs/bull": "^11.0.2",
    "@nestjs/common": "11.0.11",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "11.0.11",
    "@nestjs/platform-express": "^11.0.13",
    "@nestjs/swagger": "^11.1.1",
    "@prisma/client": "^5.22.0",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "bull": "^4.16.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "express-rate-limit": "^6.7.0",
    "express-sanitizer": "^1.0.6",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pdf-parse": "^1.1.1",
    "pdf2json": "^3.1.6",
    "pino": "^8.12.0",
    "pino-papertrail": "^2.1.0",
    "pino-syslog": "^3.2.0",
    "prisma": "^5.22.0",
    "xss-clean": "^0.1.4"
