  "description": "Servicio para cargar a OptiPension la Historia Laboral de un afiliado al RPM",
  "main": "dist/main.js",
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
