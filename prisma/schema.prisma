generator client {
  provider = "prisma-client-js"
}

// -----------------------------------------------------------------------------
// WARNING: Do not modify the datasource configuration without coordination …
// -----------------------------------------------------------------------------

datasource db {
  provider            = "postgresql"
  url                 = env("DATABASE_URL")
  shadowDatabaseUrl   = env("SHADOW_DATABASE_URL")
}

model HlHistoryLaboralUpload {
  id                Int      @id @default(autoincrement())
  uu                String   @default(dbgenerated("optipension.generate_uuid()")) @db.VarChar(36)
  userId            String   @db.VarChar(64) // ID de usuario Auth0
  documentType      String   @db.VarChar(2)
  documentNumber    String   @db.VarChar(12)
  originalFilename  String   @db.VarChar(255)
  fileSize          Int
  spacesKey         String   @db.VarChar(255)
  spacesUrl         String   @db.VarChar(512)
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  createdBy         String?  @db.VarChar(64) @map("created_by")
  updatedBy         String?  @db.VarChar(64) @map("updated_by")

  @@map("hl_history_laboral_uploads")
}